LISTEN_ADDR=:8080
# Auth is ON by default. Production: set AUTH_PASSWORD; leave AUTH_DISABLED unset.
# Local/dev only: AUTH_DISABLED=true.
AUTH_DISABLED=true
# AUTH_PASSWORD=
# AUTH_DEV_AGENT_TOKEN=  # only when AUTH_DISABLED=true
# AUTH_TRUSTED_PROXY=true
# AUTH_PUBLIC_ORIGIN=https://fireproxy.example
STORE_SIZE=64
DATA_PATH=./data/fireproxy.db
RETENTION_DAYS=90
# Optional modules (comma-separated): unifi-sync, tplink-sync, ha-mqtt
MODULES=
UNIFI_BASE_URL=https://unifi.lan:11443
UNIFI_API_KEY=
# Required to store TP-Link / OIDC secrets at rest. Exactly 64 hex chars (32 bytes).
# Generate: openssl rand -hex 32
FIREPROXY_SECRETS_KEY=
