# Auth is ON by default. Production: set AUTH_PASSWORD (required) and leave AUTH_DISABLED unset.
# Local/dev only: AUTH_DISABLED=true (loud opt-out). Never use AUTH_DISABLED on a shared host.
#
# Non-local deploy: put TLS (reverse proxy) in front of the UI/API. Do not expose raw HTTP.
# When proxied, set both of the following (also required with the bundled UI nginx):
# AUTH_TRUSTED_PROXY=true   # Secure cookies via X-Forwarded-Proto; rate limits via rightmost XFF
# AUTH_PUBLIC_ORIGIN=https://fireproxy.example  # CSRF + WebSocket origin
AUTH_DISABLED=true
# AUTH_PASSWORD=
# AUTH_DEV_AGENT_TOKEN=  # static agent token; only when AUTH_DISABLED=true
# AUTH_TRUSTED_PROXY=true
# AUTH_PUBLIC_ORIGIN=https://fireproxy.example
STORE_SIZE=64
RETENTION_DAYS=90
# GeoIP is optional (region map). Bring your own MaxMind GeoLite2 Country .mmdb — do not
# commit the database. Attribution: see NOTICE. Leave GEOIP_MMDB empty to disable.
GEOIP_MMDB=/data/GeoLite2-Country.mmdb
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=
GEOIP_UPDATE_EVERY=12h
MODULES=
UNIFI_BASE_URL=https://unifi.lan:11443
UNIFI_API_KEY=
# AES-GCM key for UI-stored secrets (TP-Link, OIDC client secret). Exactly 64 hex chars (32 bytes).
# Generate: openssl rand -hex 32
FIREPROXY_SECRETS_KEY=
# UI Debug nav (Simulate VRACK devices, etc.). 1 = on
DEBUG=0
# Image tag for docker-compose.yml (GHCR). Ignored by docker-compose.dev.yml.
# FIREPROXY_TAG=latest
