PUSH_URL=http://192.168.1.10:8081/v1/ingest
# From enroll (Settings → Firewalla). Re-enroll after auth upgrade; supersedes prior tokens.
# With AUTH_DISABLED=true on server, may match AUTH_DEV_AGENT_TOKEN instead.
AGENT_TOKEN=changeme
INTERVAL=60s
INVENTORY_INTERVAL=1h
IFACES=eth1,eth2,eth3,br0,br2,br3,br4,wg0,wg_ap
REDIS_ADDR=127.0.0.1:6379
DNSMASQ_ACL_LOG=/alog/dnsmasq-acl.log
HTTP_TIMEOUT=5s
# Prefer Settings → Firewalla enroll one-liner over hand-editing this file.
# CATALOG_URL=http://192.168.1.10:8081/v1/catalog
# AGENT_WS_URL=ws://192.168.1.10:8081/v1/agent/ws
# AGENT_SELF_UPDATE=1
# LOG_SYNC_INTERVAL=1h
# LOG_SYNC_STAGGER=15m
# LOG_CURSOR_PATH=/home/pi/.fireproxy/log-cursors.json
# HOSTNAME=Firewalla
# COLLECT_CPU=false
